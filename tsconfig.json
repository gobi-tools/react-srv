{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false,
    "noImplicitAny": false,
    "declaration": true,
    "declarationMap": true,
  }
}